<div id="boop-widget" style="
display: inline-flex;
align-items: center;
gap: 1rem;
cursor: pointer;
user-select: none;
font-family: 'Inter', system-ui, -apple-system, sans-serif;
">
<img
id="boop-img"
src="https://eggwuh.net/assets/images/image01.gif"
alt="Boop"
style="
width: 400px;
height: 400px;
border-radius: 75%;
object-fit: cover;
border: 6px solid #ff6b9d;
box-shadow: 0 4px 12px rgba(255, 107, 157, 0.3);
transition: box-shadow 0.2s ease;
"
>

<div style="text-align: left; line-height: 1.2;">
<div id="boop-count" style="
font-size: 1.8rem;
font-weight: 700;
color: #E5CCEB;
text-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
margin-top: 2px;
transition: transform 0.15s ease;
">0</div>
<div style="font-size: 0.8rem;
font-weight: 400;
color: #E5CCEB;
text-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
margin-top: 2px;
opacity: 0.9;">
Boops 👆
</div>
</div>
</div>

<style>
@keyframes boop-bounce {
0% { transform: scale(1); }
30% { transform: scale(0.85); }
50% { transform: scale(1.15); }
70% { transform: scale(0.95); }
100% { transform: scale(1); }
}
#boop-img.bounce {
animation: boop-bounce 0.45s ease;
}
</style>

<script>
(function() {
// ── CHANGE THESE ──────────────────────────────────────
const KEY = 'gwuhgwuh-carrd-boops'; // make this unique!
const IMG = 'https://eggwuh.net/assets/images/image01.gif'; // your image URL
// ─────────────────────────────────────────────────────

const API = 'https://countapi.mileshilliard.com/api/v1';

function init() {
const countEl = document.getElementById('boop-count');
const imgEl = document.getElementById('boop-img');
const widget = document.getElementById('boop-widget');

if (!countEl || !imgEl || !widget) {
console.error('Boop elements not found');
return;
}

imgEl.src = IMG;

// Always show something immediately
countEl.textContent = '0';

// Load real count
fetch(API + '/get/' + encodeURIComponent(KEY))
.then(function(r) { return r.json(); })
.then(function(data) {
if (data && data.value !== undefined) {
countEl.textContent = data.value;
}
})
.catch(function(err) {
console.error('Failed to load count:', err);
countEl.textContent = '0';
});

// Click to increment
widget.addEventListener('click', function() {
// Bounce animation
imgEl.classList.remove('bounce');
void imgEl.offsetWidth;
imgEl.classList.add('bounce');

// Number pop
countEl.style.transform = 'scale(1.2)';
setTimeout(function() {
countEl.style.transform = 'scale(1)';
}, 150);

// Hit the API
fetch(API + '/hit/' + encodeURIComponent(KEY))
