<div id="boop-widget" style="
  display:inline-flex;
  align-items:center;
  gap:16px;
  width:max-content;
  cursor:pointer;
  user-select:none;
  font-family:'Inter',system-ui,-apple-system,sans-serif;
">
<img
  id="boop-img"
  src="https://eggwuh.net/assets/images/image01.gif"
  alt="Boop"
  style="
    width:400px;
    height:400px;
    flex:0 0 400px;
    border-radius:75%;
    object-fit:cover;
    border:6px solid #ff6b9d;
    box-shadow:0 4px 12px rgba(255,107,157,.3);
  "
>

<div style="text-align:center; line-height:1.2; width:100px; flex:0 0 100px;">
  <div id="boop-count" style="
    width:100px;
    box-sizing:border-box;
    font-size:1.8rem;
    font-weight:700;
    color:#E5CCEB;
    text-align:center;
    font-variant-numeric:tabular-nums;
    white-space:nowrap;
    text-shadow:0 2px 6px rgba(0,0,0,.35);
    margin-top:2px;
    transition:transform .15s ease;
  ">0</div>

 <div style="
    font-size:.8rem;
    font-weight:400;
    color:#E5CCEB;
    text-align:center;
    white-space:nowrap;
    color:#E5CCEB;
    text-shadow:0 2px 6px rgba(0,0,0,.35);
    margin-top:2px;
    opacity:.9;
  ">Boops 👆</div>
</div>
</div>

<style>
@keyframes boop-bounce {
0% { transform: scale(1); }
30% { transform: scale(0.85); }
50% { transform: scale(1.15); }
70% { transform: scale(0.95); }
100% { transform: scale(1); }
}
#boop-img.bounce {
animation: boop-bounce 0.45s ease;
}
</style>

<script>
(function () {
  const KEY = 'gwuhgwuh-carrd-boops'; // Change key to your unique key
  const IMG = 'https://eggwuh.net/assets/images/image01.gif';
  const API = 'https://countapi.mileshilliard.com/api/v1';

  const widget = document.getElementById('boop-widget');
  const countEl = document.getElementById('boop-count');
  const imgEl = document.getElementById('boop-img');

  if (!widget || !countEl || !imgEl) {
    console.error('Boop elements not found');
    return;
  }

  let count = 0;
  let pending = false;

  function setCount(value) {
    count = Number(value) || 0;
    countEl.textContent = count;
  }

  function loadCount() {
    fetch(https://countapi.mileshilliard.com/api/v1/get/gwuhgwuh-carrd-boops)
      .then(function (response) {
        if (!response.ok) {
          throw new Error('CountAPI get failed: ' + response.status);
        }
        return response.json();
      })
      .then(function (data) {
        if (data && data.value !== undefined) {
          setCount(data.value);
        }
      })
      .catch(function (err) {
        console.warn('Could not load count:', err);
      });
  }

  function boop() {
    if (pending) return;
    pending = true;

    imgEl.classList.remove('bounce');
    void imgEl.offsetWidth;
    imgEl.classList.add('bounce');

    setCount(count + 1);

    fetch(https://countapi.mileshilliard.com/api/v1/hit/gwuhgwuh-carrd-boops)
      .then(function (response) {
        if (!response.ok) {
          throw new Error('CountAPI hit failed: ' + response.status);
        }
        return response.json();
      })
      .then(function (data) {
        if (data && data.value !== undefined) {
          setCount(data.value);
        }
      })
      .catch(function (err) {
        console.warn('Could not update count:', err);
      })
      .finally(function () {
        pending = false;
      });
  }

  imgEl.src = IMG;

  widget.addEventListener('click', boop);

  widget.addEventListener('keydown', function (event) {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      boop();
    }
  });

  loadCount();
})();
</script>
